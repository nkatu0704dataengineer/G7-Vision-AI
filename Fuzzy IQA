import numpy as np                     # Thư viện xử lý mảng số
import skfuzzy as fuzz                # Thư viện fuzzy logic
from skfuzzy import control as ctrl   # Module tạo fuzzy control system


class FuzzyFaceQualityAssessor:
    def __init__(self):

        # ==================================================
        # 1. DEFINE INPUT / OUTPUT UNIVERSE RANGE
        # ==================================================

        # Blur (độ mờ ảnh) — thường lấy từ Variance of Laplacian
        self.blur = ctrl.Antecedent(np.arange(0, 1001, 1), 'blur')

        # Brightness (độ sáng trung bình pixel)
        self.brightness = ctrl.Antecedent(np.arange(0, 256, 1), 'brightness')

        # Contrast (độ tương phản ảnh)
        self.contrast = ctrl.Antecedent(np.arange(0, 101, 1), 'contrast')

        # Noise (mức nhiễu ảnh)
        self.noise = ctrl.Antecedent(np.arange(0, 51, 1), 'noise')

        # Output: Quality (chất lượng tổng thể ảnh khuôn mặt)
        self.quality = ctrl.Consequent(np.arange(0, 101, 1), 'quality')


        # ==================================================
        # 2. MEMBERSHIP FUNCTIONS (FUZZY SETS)
        # ==================================================

        # -------- BLUR --------
        self.blur['low'] = fuzz.trapmf(self.blur.universe, [0, 0, 150, 300])       # Ảnh rõ
        self.blur['medium'] = fuzz.trimf(self.blur.universe, [200, 450, 700])      # Mờ vừa
        self.blur['high'] = fuzz.trapmf(self.blur.universe, [600, 800, 1000, 1000])# Mờ nhiều

        # -------- BRIGHTNESS --------
        self.brightness['low'] = fuzz.trapmf(self.brightness.universe, [0, 0, 60, 90])
        self.brightness['medium'] = fuzz.trimf(self.brightness.universe, [80, 128, 180])
        self.brightness['high'] = fuzz.trapmf(self.brightness.universe, [170, 210, 255, 255])

        # -------- CONTRAST --------
        self.contrast['low'] = fuzz.trapmf(self.contrast.universe, [0, 0, 25, 40])
        self.contrast['medium'] = fuzz.trimf(self.contrast.universe, [30, 55, 80])
        self.contrast['high'] = fuzz.trapmf(self.contrast.universe, [70, 85, 100, 100])

        # -------- NOISE --------
        self.noise['low'] = fuzz.trapmf(self.noise.universe, [0, 0, 10, 18])
        self.noise['medium'] = fuzz.trimf(self.noise.universe, [12, 25, 38])
        self.noise['high'] = fuzz.trapmf(self.noise.universe, [30, 40, 50, 50])

        # -------- OUTPUT QUALITY --------
        self.quality['poor'] = fuzz.trapmf(self.quality.universe, [0, 0, 30, 45])       # Kém
        self.quality['acceptable'] = fuzz.trimf(self.quality.universe, [35, 55, 75])    # Tạm ổn
        self.quality['good'] = fuzz.trapmf(self.quality.universe, [65, 80, 100, 100])   # Tốt


        # ==================================================
        # 3. RULE BASE (LUẬT SUY DIỄN)
        # ==================================================

        rules = [

            # Blur cao hoặc Noise cao → Ảnh kém
            ctrl.Rule(self.blur['high'] | self.noise['high'], self.quality['poor']),

            # Brightness quá thấp hoặc quá cao → Ảnh kém
            ctrl.Rule(self.brightness['low'] | self.brightness['high'], self.quality['poor']),

            # Ảnh nét + contrast cao + sáng vừa → Ảnh tốt
            ctrl.Rule(self.blur['low'] & self.contrast['high'] & self.brightness['medium'], self.quality['good']),

            # Blur vừa + contrast vừa → Tạm ổn
            ctrl.Rule(self.blur['medium'] & self.contrast['medium'], self.quality['acceptable']),

            # Noise thấp + contrast cao → Tốt
            ctrl.Rule(self.noise['low'] & self.contrast['high'], self.quality['good']),

            # Contrast thấp nhưng blur thấp → Acceptable
            ctrl.Rule(self.contrast['low'] & self.blur['low'], self.quality['acceptable']),

            # Blur cao dù brightness ok → Poor
            ctrl.Rule(self.blur['high'] & self.brightness['medium'], self.quality['poor']),

            # Noise vừa + contrast vừa → Acceptable
            ctrl.Rule(self.noise['medium'] & self.contrast['medium'], self.quality['acceptable']),

            # Blur thấp + noise thấp + brightness tốt → Good
            ctrl.Rule(self.blur['low'] & self.noise['low'] & self.brightness['medium'], self.quality['good']),

            # Brightness tốt + contrast cao → Good
            ctrl.Rule(self.brightness['medium'] & self.contrast['high'], self.quality['good']),

            # Blur vừa + noise vừa → Acceptable (đã chỉnh mềm hơn)
            ctrl.Rule(self.blur['medium'] & self.noise['medium'], self.quality['acceptable']),

            # Contrast cao + noise thấp → Good
            ctrl.Rule(self.contrast['high'] & self.noise['low'], self.quality['good']),

            # Brightness thấp + contrast thấp → Poor
            ctrl.Rule(self.brightness['low'] & self.contrast['low'], self.quality['poor']),

            # Blur vừa + brightness vừa + noise thấp → Acceptable
            ctrl.Rule(self.blur['medium'] & self.brightness['medium'] & self.noise['low'], self.quality['acceptable']),

            # Contrast cao nhưng blur cao → Poor
            ctrl.Rule(self.contrast['high'] & self.blur['high'], self.quality['poor'])
        ]


        # ==================================================
        # 4. BUILD FUZZY SYSTEM
        # ==================================================

        self.quality_ctrl = ctrl.ControlSystem(rules)                       # Tạo control system
        self.quality_sim = ctrl.ControlSystemSimulation(self.quality_ctrl)  # Tạo simulator để chạy


    # ==================================================
    # 5. EVALUATE FUNCTION (DÙNG THỰC TẾ)
    # ==================================================

    def evaluate(self, blur, brightness, contrast, noise):

        # Gán input vào fuzzy system
        self.quality_sim.input['blur'] = blur
        self.quality_sim.input['brightness'] = brightness
        self.quality_sim.input['contrast'] = contrast
        self.quality_sim.input['noise'] = noise

        # Chạy suy luận fuzzy
        self.quality_sim.compute()

        # Trả kết quả quality score
        return self.quality_sim.output['quality']