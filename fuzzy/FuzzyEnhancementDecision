    def enhance(self, img):

        enhanced = img.copy()

        # CLAHE nếu contrast thấp
        if img.std() < 35:
            clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))
            enhanced = clahe.apply(enhanced)

        # Sharpen nếu blur cao
        if cv2.Laplacian(img, cv2.CV_64F).var() < 100:
            kernel = np.array([[0,-1,0],
                               [-1,5,-1],
                               [0,-1,0]])
            enhanced = cv2.filter2D(enhanced, -1, kernel)

        # Denoise nếu noise cao
        noise = np.std(img - cv2.GaussianBlur(img,(5,5),0))
        if noise > 15:
            enhanced = cv2.fastNlMeansDenoising(enhanced)

        # lưu ảnh output
        cv2.imwrite("final_output.jpg", enhanced)

        return enhanced
